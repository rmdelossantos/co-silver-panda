PORT=3000
CORS_ORIGIN=http://localhost:5173
DB_PATH=data/catalog.db

# Accounts and sign-in
# Set false once your team has accounts.
ALLOW_SIGNUP=true
# Default: true when NODE_ENV=production. Set false for plain-HTTP deploys.
COOKIE_SECURE=
# Behind a reverse proxy, a hop count such as 1 (never "true").
TRUST_PROXY=false
SESSION_TTL_HOURS=168
